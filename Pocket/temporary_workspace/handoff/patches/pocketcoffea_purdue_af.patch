             "PYTHONPATH",
             "LD_LIBRARY_PATH",
             "X509_CERT_DIR",
-            "PATH"
+            "PATH",
+            # One dask task already occupies a core. Without these the
+            # processor's BLAS/OpenMP layer grabs ~22 threads PER TASK
+            # (measured: 10m12s wall vs 224m user on one 4.8k-event chunk),
+            # so concurrent tasks spin against each other. Parallelism must
+            # come from many tasks, not from threads inside one task.
+            "OMP_NUM_THREADS",
+            "OPENBLAS_NUM_THREADS",
+            "MKL_NUM_THREADS",
+            "NUMEXPR_NUM_THREADS",
+            "VECLIB_MAXIMUM_THREADS",
         ]
         for var in propagate_env:
             if var in os.environ:
